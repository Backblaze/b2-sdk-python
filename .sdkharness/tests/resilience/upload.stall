#!/usr/bin/env python3
"""b2-sdk-python x upload.stall.

Written from the reference check, upload.retry_503 in this directory.
The question is the upload.stall scenario of the central sdkharness registry.

Fault   wire b2_upload_file stall ms=60000, armed after setup, so the first upload
        attempt is the one that stalls. The scenario needs a client request timeout
        short enough to beat a 60 s stall (`needs: request-timeout`); b2sdk has no
        timeout option, so the check meets it through B2HttpApiConfig's documented
        `http_session_factory` (a Session that clamps the read timeout to 5 s)
Assert  the recovery path, from GET /journal: exactly one stall on b2_upload_file,
        then a successful b2_upload_file on a DIFFERENT uploadUrlId; and the end
        state, through the normal API: the file downloads with the bytes that went up

The expected behaviour is B2's, not the tool's.
The Integration Checklist, Upload Retry Guidelines, lists the failures after which "the
developer should call b2_get_upload_url or b2_get_upload_part_url and re-attempt the
upload using the new URL and auth key pair"; among them:
"The HTTPS connection times out waiting for a response (socket timeout)."
https://www.backblaze.com/docs/cloud-storage-integration-checklist

It exercises b2sdk from this exact repository checkout;
the API is taken from the published b2sdk documentation.
"""

import hashlib
import io
import json
import os
import sys
import urllib.request
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
from loopback_guard import missing_runtime, refusal  # noqa: E402

SLUG = 'b2-sdk-python'
SCENARIO = 'upload.stall'
OBJECT_NAME = 'res/stall.txt'
ARM_PATH = '/wire-faults'
FAULT = {'on': 'b2_upload_file', 'kind': 'stall', 'ms': 60000, 'count': 1}


def is_faulted(e):
    return e['endpoint'] == 'b2_upload_file' and e['fault'] == 'stall'


# The closed reason set, fixed by the sdkharness resilience contract. This
# scenario's `needs` is `request-timeout`, so no-client-option is available to it.
REASONS = ('missing-runtime', 'no-client-option')


class Amber(Exception):
    """The question could not be asked. Reason must be in REASONS."""

    def __init__(self, reason: str, detail: str) -> None:
        assert reason in REASONS, reason
        self.reason = reason
        self.detail = detail


class Failure(Exception):
    def __init__(self, step: str, detail: str) -> None:
        self.step = step
        self.detail = detail


def say(verdict: str) -> None:
    print(f'RESILIENCE {SLUG} {SCENARIO} @simulator: {verdict}')


def note(text: str) -> None:
    print(f'NOTE {SLUG} {SCENARIO}: {text}')


def step(name: str, action):
    """Run one step; any error is a FAIL naming the step and exception class.

    There is no unreachable/unauthorized amber here: the runner supplies the
    server and the credential, so either failing is a harness defect.
    """
    try:
        return action()
    except (Amber, Failure):
        raise
    except Exception as error:  # noqa: BLE001 -- only the class name is reported
        raise Failure(name, type(error).__name__) from error


def control(method: str, path: str, body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(
        os.environ['RESILIENCE_CONTROL_URL'] + path,
        data=data,
        method=method,
        headers={'content-type': 'application/json'},
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.load(resp)


def journal():
    return step('journal', lambda: control('GET', '/journal'))['entries']


def after(entries, seq, endpoint, status=None):
    """Entries on `endpoint` later than `seq`, optionally with one status."""
    return [
        e
        for e in entries
        if e['seq'] > seq
        and e['endpoint'] == endpoint
        and (status is None or e['status'] == status)
    ]


def authorized_bucket(**api_kwargs):
    realm = os.environ['RESILIENCE_SIMULATOR_URL']
    try:
        from b2sdk.v3 import B2Api, InMemoryAccountInfo
    except ImportError as error:
        if not missing_runtime(error):
            # b2sdk is installed but broken: an SDK regression, not a missing runtime
            raise Failure('import', type(error).__name__) from error
        raise Amber('missing-runtime', 'b2sdk is not installed') from error
    api = B2Api(InMemoryAccountInfo(), **api_kwargs)
    step('authenticate', lambda: api.authorize_account('test-key-id', 'test-key', realm=realm))
    bucket = step(
        'create bucket',
        lambda: api.create_bucket(f'sdkharness-res-{uuid.uuid4().hex[:12]}', 'allPrivate'),
    )
    return api, bucket


# The request-timeout precondition (`needs: request-timeout`). b2sdk has no timeout option, but
# B2HttpApiConfig documents `http_session_factory` (a callable returning a requests.Session), and
# B2Http (b2sdk/_internal/b2http.py) hands its timeout to that session on every call:
# `self.session.request(..., timeout=(CONNECTION_TIMEOUT, _timeout or TIMEOUT_FOR_UPLOAD))`. A Session
# subclass that clamps the read timeout therefore makes a stalled response give up early.
REQUEST_TIMEOUT_S = 5


def short_timeout_session_class():
    import requests

    class ShortTimeoutSession(requests.Session):
        def request(self, method, url, **kwargs):
            timeout = kwargs.get('timeout')
            connect = timeout[0] if isinstance(timeout, tuple) else timeout
            kwargs['timeout'] = (connect or REQUEST_TIMEOUT_S, REQUEST_TIMEOUT_S)
            return super().request(method, url, **kwargs)

    return ShortTimeoutSession


def run() -> None:
    try:
        from b2sdk.v3 import B2HttpApiConfig
    except ImportError as error:
        if not missing_runtime(error):
            # b2sdk is installed but broken: an SDK regression, not a missing runtime
            raise Failure('import', type(error).__name__) from error
        raise Amber('missing-runtime', 'b2sdk is not installed') from error
    note(
        'request-timeout met through B2HttpApiConfig(http_session_factory=...), a documented '
        f'parameter: a Session subclass clamps the read timeout to {REQUEST_TIMEOUT_S} s'
    )
    config = B2HttpApiConfig(http_session_factory=short_timeout_session_class())
    api, bucket = authorized_bucket(api_config=config)

    payload = (b'sdkharness resilience ' * 64)[:1024]
    step('arm fault', lambda: control('POST', ARM_PATH, FAULT))
    uploaded = step('upload', lambda: bucket.upload_bytes(payload, OBJECT_NAME))
    if hashlib.sha1(payload).hexdigest() != getattr(uploaded, 'content_sha1', None):
        raise Failure('upload', 'the returned contentSha1 does not match the bytes sent')

    sink = io.BytesIO()
    step('download', lambda: bucket.download_file_by_name(OBJECT_NAME).save(sink))
    if sink.getvalue() != payload:
        raise Failure('round trip', 'downloaded bytes differ from what was uploaded')

    entries = journal()
    stalled = [e for e in entries if is_faulted(e)]
    if len(stalled) != 1:
        raise Failure('journal', f'{len(stalled)} stalls on b2_upload_file, expected 1')
    retries = after(entries, stalled[0]['seq'], 'b2_upload_file', 200)
    if not retries:
        raise Failure('journal', 'no successful b2_upload_file after the stall')
    if retries[0]['uploadUrlId'] in (None, stalled[0]['uploadUrlId']):
        raise Failure('recovery path', 'the retry reused the upload URL that stalled')


def main() -> int:
    refused = refusal('resilience')
    if refused:
        say(f'FAIL ({refused})')
        return 1
    try:
        run()
    except Amber as amber:
        say(f'COULD-NOT-RUN ({amber.reason} -- {amber.detail})')
        return 0
    except Failure as failure:
        say(f'FAIL ({failure.step} -- {failure.detail})')
        return 1
    except Exception as error:  # noqa: BLE001 -- never a silent crash
        say(f'FAIL (setup -- {type(error).__name__})')
        return 1
    say('PASS')
    return 0


if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/env python3
"""Reference conformance check: b2-sdk-python x files.upload.

The other conformance checks in this directory follow the same structure; this
file is the simplest example of it.

Scenario (one per capability, identical on every tool that claims it):

    Setup   an ephemeral bucket and a 1 KiB payload of known sha1
    Action  upload it to st/upload.txt
    Assert  the call returns fileId + fileName; metadata reports
            contentLength 1024 and the matching contentSha1; the downloaded
            bytes are identical to what went up

The expected values are B2's published contract. b2_upload_file "Uploads
one file and returns its unique file ID"; its response carries fileId ("The
unique identifier for this version of this file"), fileName, contentLength
("The number of bytes stored in the file") and contentSha1 ("The SHA1 of the
bytes stored in the file as a 40-digit hex string").
https://www.backblaze.com/apidocs/b2-upload-file
The round trip holds because b2_download_file_by_name returns headers that
"contain the same information they did when the file was uploaded".
https://www.backblaze.com/apidocs/b2-download-file-by-name

It exercises b2sdk from this exact repository checkout. The API usage is taken
from the published b2sdk documentation.
"""

import hashlib
import io
import os
import sys
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
from loopback_guard import missing_runtime, refusal  # noqa: E402

SLUG = 'b2-sdk-python'
CAPABILITY = 'files.upload'
OBJECT_NAME = 'st/upload.txt'
PAYLOAD_SIZE = 1024

# The closed reason set. `lib/contract.py` only turns `no-realm-option`,
# `missing-runtime` and `not-claimed` into a SKIP. `unreachable` and
# `unauthorized` are never reported at the simulator: the runner supplies both
# the server and the credential, so those are FAIL, not amber.
REASONS = (
    'no-realm-option',
    'unreachable',
    'unauthorized',
    'no-credential',
    'missing-runtime',
    'not-claimed',
)

# A requested target maps to a realm or to amber. `simulator` is the harness's
# own loopback server, whose URL the dispatcher exports as
# CONFORMANCE_SIMULATOR_URL; unset, there is nothing to reach: no-realm-option.
REALMS = {
    'simulator': os.environ.get('CONFORMANCE_SIMULATOR_URL') or None,
}

# The simulator's fixed test credential, which the runner also injects. At
# @simulator the check uses it directly, so a real B2_* value can never be
# sent there.
SIM_CREDENTIAL = ('test-key-id', 'test-key')


class Amber(Exception):
    """The question could not be asked. Reason must be in REASONS."""

    def __init__(self, reason: str, detail: str) -> None:
        assert reason in REASONS, reason
        self.reason = reason
        self.detail = detail


class Failure(Exception):
    """A golden-path step that did not do what the capability requires."""

    def __init__(self, step: str, detail: str) -> None:
        self.step = step
        self.detail = detail


def say(target: str, verdict: str) -> None:
    print(f'CONFORMANCE {SLUG} {CAPABILITY} @{target}: {verdict}')


def step(name: str, action):
    """Run one golden-path step, converting the environment's own errors.

    A credential NEVER reaches the detail: only the exception class name.
    Every error here is a FAIL: the runner supplies both the simulator and the
    credential, so an auth error, access denied, connection error or SDK error
    is a defect, never an amber (COULD-NOT-RUN) result.
    """
    try:
        return action()
    except (Amber, Failure):
        raise
    except Exception as error:  # noqa: BLE001 -- classified below, never echoed
        name_of = type(error).__name__
        raise Failure(name, name_of) from error


def run(target: str) -> None:
    realm = REALMS.get(target)
    if realm is None:
        detail = (
            'CONFORMANCE_SIMULATOR_URL is unset'
            if target == 'simulator'
            else f"b2sdk exposes no '{target}' realm"
        )
        raise Amber('no-realm-option', detail)

    key_id, key = SIM_CREDENTIAL

    try:
        from b2sdk.v3 import B2Api, InMemoryAccountInfo
    except ImportError as error:
        if not missing_runtime(error):
            # b2sdk is installed but broken: an SDK regression, not a missing runtime
            raise Failure('import', type(error).__name__) from error
        raise Amber('missing-runtime', 'b2sdk is not installed') from error

    api = B2Api(InMemoryAccountInfo())
    step(
        'authenticate',
        lambda: api.authorize_account(key_id, key, realm=realm),
    )

    payload = (b'sdkharness conformance ' * 64)[:PAYLOAD_SIZE]
    assert len(payload) == PAYLOAD_SIZE
    expected_sha1 = hashlib.sha1(payload).hexdigest()

    bucket_name = f'sdkharness-conf-{uuid.uuid4().hex[:12]}'
    bucket = step('create bucket', lambda: api.create_bucket(bucket_name, 'allPrivate'))
    try:
        uploaded = step('upload', lambda: bucket.upload_bytes(payload, OBJECT_NAME))

        if not getattr(uploaded, 'id_', None):
            raise Failure('upload', 'the upload returned no fileId')
        if getattr(uploaded, 'file_name', None) != OBJECT_NAME:
            raise Failure('upload', 'the upload returned a different fileName')

        info = step('metadata', lambda: api.get_file_info(uploaded.id_))
        size = info.get('contentLength') if isinstance(info, dict) else getattr(info, 'size', None)
        sha1 = (
            info.get('contentSha1')
            if isinstance(info, dict)
            else getattr(info, 'content_sha1', None)
        )
        if size != PAYLOAD_SIZE:
            raise Failure('metadata', f'contentLength {size}, expected {PAYLOAD_SIZE}')
        if sha1 != expected_sha1:
            raise Failure('metadata', 'contentSha1 does not match the uploaded bytes')

        sink = io.BytesIO()
        step('download', lambda: bucket.download_file_by_name(OBJECT_NAME).save(sink))
        if sink.getvalue() != payload:
            raise Failure('round trip', 'downloaded bytes differ from what was uploaded')
    finally:
        # Owns what it created, on the error path too.
        try:
            for version, _folder in bucket.ls(OBJECT_NAME, recursive=True, latest_only=False):
                bucket.delete_file_version(version.id_, version.file_name)
            api.delete_bucket(bucket)
        except Exception:  # noqa: BLE001 -- cleanup must not mask the verdict
            pass


def main() -> int:
    target = os.environ.get('CONFORMANCE_TARGET', 'simulator')
    refused = refusal('conformance')
    if refused:
        say(target, f'FAIL ({refused})')
        return 1
    try:
        run(target)
    except Amber as amber:
        say(target, f'COULD-NOT-RUN ({amber.reason} -- {amber.detail})')
        return 0
    except Failure as failure:
        say(target, f'FAIL ({failure.step} -- {failure.detail})')
        return 1
    except Exception as error:  # noqa: BLE001 -- never a silent crash
        say(target, f'FAIL (setup -- {type(error).__name__})')
        return 1
    say(target, 'PASS')
    return 0


if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/env python3
"""b2-sdk-python x large.compose_mixed.

Scenario (approved 2026-09-22, one per capability, identical on every tool that
claims it):

    Setup   a local byte range, a range copied from an existing object, and
            an already-stored object used whole
    Action  compose one file from all three (Bucket.concatenate)
    Assert  the result equals the ordered concatenation of the three

    Every piece is at least the account's absolute minimum part size, because
    b2_copy_part refuses a smaller non-final part -- the scenario's shape, sized
    to what the service will actually accept.

DOCS -- "a large file can be assembled from a mix of uploaded and copied
parts." https://www.backblaze.com/docs/cloud-storage-large-files
b2_copy_part: "Copies from an existing B2 file, storing it as a part of a
large file which has already been started with b2_start_large_file." Its
range: "The range of bytes to copy. If not provided, the whole source file
will be copied." https://www.backblaze.com/apidocs/b2-copy-part
Part sizes: "the minimum part size is 5 MB except for the last part in a
file which has a minimum size of 1 byte." https://www.backblaze.com/docs/cloud-storage-create-large-files-with-the-native-api

Written from files.upload in this directory, the reference check. It exercises
b2sdk from this exact repository checkout; the API usage is taken from the
published b2sdk documentation.
"""

import hashlib
import io
import os
import sys
import tempfile
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
from loopback_guard import missing_runtime, refusal  # noqa: E402

SLUG = 'b2-sdk-python'
CAPABILITY = 'large.compose_mixed'
LOCAL_SOURCE = 'st/compose-local-source.bin'
STORED_A = 'st/compose-a.bin'
STORED_B = 'st/compose-b.bin'
COMPOSED = 'st/composed.bin'

# The closed reason set. `lib/contract.py` only turns `no-realm-option`,
# `missing-runtime` and `not-claimed` into a SKIP. `unreachable` and
# `unauthorized` are never reported at the simulator: the runner supplies both
# the server and the credential, so those are FAIL, not amber.
REASONS = (
    'no-realm-option',
    'unreachable',
    'unauthorized',
    'no-credential',
    'missing-runtime',
    'not-claimed',
)

# A requested target maps to a realm or to amber. `simulator` is the harness's
# own loopback server, whose URL the dispatcher exports as
# CONFORMANCE_SIMULATOR_URL; unset, there is nothing to reach: no-realm-option.
REALMS = {
    'simulator': os.environ.get('CONFORMANCE_SIMULATOR_URL') or None,
}

# The simulator's fixed test credential, which the runner also injects. At
# @simulator the check uses it directly, so a real B2_* value can never be
# sent there.
SIM_CREDENTIAL = ('test-key-id', 'test-key')


def credential(realm):
    """The (key id, key) pair for a realm: the fixed one at @simulator."""
    if realm == REALMS['simulator']:
        return SIM_CREDENTIAL
    raise AssertionError('conformance checks use only the fixed simulator credential')


class Amber(Exception):
    """The question could not be asked. Reason must be in REASONS."""

    def __init__(self, reason: str, detail: str) -> None:
        assert reason in REASONS, reason
        self.reason = reason
        self.detail = detail


class Failure(Exception):
    """A golden-path step that did not do what the capability requires."""

    def __init__(self, step: str, detail: str) -> None:
        self.step = step
        self.detail = detail


def say(target: str, verdict: str) -> None:
    print(f'CONFORMANCE {SLUG} {CAPABILITY} @{target}: {verdict}')


def note(text: str) -> None:
    """Context for the log. NOT a result line.

    The runner reads only the CONFORMANCE line and a PASS carries no detail, so
    anything qualifying the STRENGTH of the evidence is said here, where it
    survives in the retained log without being mistaken for a verdict.
    """
    print(f'note {SLUG} {CAPABILITY}: {text}')


def step(name, action):
    """Run one golden-path step, converting the environment's own errors.

    A credential NEVER reaches the detail: only the exception class name.
    Every error here is a FAIL: the runner supplies both the simulator and the
    credential, so an auth error, access denied, connection error or SDK error
    is a defect, never an amber (COULD-NOT-RUN) result.
    """
    try:
        return action()
    except (Amber, Failure):
        raise
    except Exception as error:  # noqa: BLE001 -- classified below, never echoed
        name_of = type(error).__name__
        raise Failure(name, name_of) from error


def refused(name, action, expected):
    """Assert something is REFUSED, and record what refused it.

    `expected` is a tuple of exception class names. A different class -- or no
    exception at all -- is a Failure, because the refusal IS the claim here.
    """
    try:
        action()
    except (Amber, Failure):
        raise
    except Exception as error:  # noqa: BLE001 -- classified, never echoed
        name_of = type(error).__name__
        if name_of in expected:
            return name_of
        raise Failure(name, f"refused with {name_of}, expected {'/'.join(expected)}") from error
    raise Failure(name, 'the call was permitted; the claim under test is that it is refused')


def payload_of(size: int) -> bytes:
    """Deterministic filler of an exact size."""
    unit = b'sdkharness conformance '
    return (unit * (size // len(unit) + 1))[:size]


def prepare(target):
    """Realm, credentials and the INSTALLED package -- before any network call."""
    realm = REALMS.get(target)
    if realm is None:
        detail = (
            'CONFORMANCE_SIMULATOR_URL is unset'
            if target == 'simulator'
            else f"b2sdk exposes no '{target}' realm"
        )
        raise Amber('no-realm-option', detail)

    if not all(credential(realm)):
        raise Amber('no-credential', 'B2_APPLICATION_KEY_ID / B2_APPLICATION_KEY unset')

    try:
        import b2sdk.v3 as b2
    except ImportError as error:
        if not missing_runtime(error):
            # b2sdk is installed but broken: an SDK regression, not a missing runtime
            raise Failure('import', type(error).__name__) from error
        raise Amber('missing-runtime', 'b2sdk is not installed') from error

    return b2, realm


def authorize(api, realm):
    """Authorize against the named realm. Credentials never leave this call."""
    step(
        'authenticate',
        lambda: api.authorize_account(*credential(realm), realm=realm),
    )
    return api


def connect(target, **api_kwargs):
    """The common case: one authorized B2Api against the requested realm."""
    b2, realm = prepare(target)
    return b2, authorize(b2.B2Api(b2.InMemoryAccountInfo(), **api_kwargs), realm)


def new_bucket(api, **kwargs):
    """An ephemeral bucket, named as the contract requires."""
    name = f'sdkharness-conf-{uuid.uuid4().hex[:12]}'
    return step('create bucket', lambda: api.create_bucket(name, 'allPrivate', **kwargs))


def _delete_hard(api, bucket, version):
    """Delete one version, lifting a legal hold or a governance lock if it blocks."""
    for attempt in (0, 1):
        try:
            bucket.delete_file_version(
                version.id_, version.file_name, bypass_governance=attempt > 0
            )
            return
        except Exception:  # noqa: BLE001 -- cleanup must never mask the verdict
            if attempt == 0:
                try:
                    import b2sdk.v3 as b2

                    api.update_file_legal_hold(version.id_, version.file_name, b2.LegalHold.OFF)
                except Exception:  # noqa: BLE001
                    pass


def teardown(api, *buckets):
    """Owns what it created and destroys it, on the error path too."""
    for bucket in buckets:
        if bucket is None:
            continue
        try:
            for unfinished in bucket.list_unfinished_large_files():
                try:
                    bucket.cancel_large_file(unfinished.file_id)
                except Exception:  # noqa: BLE001
                    pass
        except Exception:  # noqa: BLE001
            pass
        try:
            versions = [v for v, _folder in bucket.ls('', recursive=True, latest_only=False)]
        except Exception:  # noqa: BLE001
            versions = []
        for version in versions:
            _delete_hard(api, bucket, version)
        try:
            api.delete_bucket(bucket)
        except Exception:  # noqa: BLE001
            pass


def drop_keys(api, key_ids):
    """Application keys are resources too."""
    for key_id in key_ids:
        if not key_id:
            continue
        try:
            api.delete_key_by_id(key_id)
        except Exception:  # noqa: BLE001
            pass


def run(target: str) -> None:
    b2, realm = prepare(target)
    api = authorize(b2.B2Api(b2.InMemoryAccountInfo()), realm)

    part_size = api.account_info.get_absolute_minimum_part_size()

    local_bytes = payload_of(part_size * 2)
    stored_a_bytes = payload_of(part_size * 2)[::-1]
    stored_b_bytes = payload_of(part_size)

    scratch = tempfile.mkdtemp(prefix='sdkharness-conf-')
    local = os.path.join(scratch, 'compose-local.bin')
    with open(local, 'wb') as handle:
        handle.write(local_bytes)

    bucket = new_bucket(api)
    try:
        a = step('upload stored source A', lambda: bucket.upload_bytes(stored_a_bytes, STORED_A))
        b = step('upload stored source B', lambda: bucket.upload_bytes(stored_b_bytes, STORED_B))

        # 1. a range of a LOCAL file  2. a RANGE of a stored object
        # 3. a stored object used WHOLE (the already-stored piece)
        sources = [
            b2.UploadSourceLocalFileRange(local, offset=0, length=part_size),
            b2.CopySource(a.id_, offset=part_size, length=part_size),
            b2.CopySource(b.id_, offset=0, length=part_size),
        ]
        expected = (
            local_bytes[:part_size] + stored_a_bytes[part_size : part_size * 2] + stored_b_bytes
        )

        composed = step(
            'compose',
            lambda: bucket.concatenate(
                sources,
                COMPOSED,
                recommended_upload_part_size=part_size,
                min_part_size=part_size,
                max_part_size=part_size,
            ),
        )
        if not getattr(composed, 'id_', None):
            raise Failure('compose', 'the composition returned no fileId')

        sink = io.BytesIO()
        step('download the composition', lambda: bucket.download_file_by_name(COMPOSED).save(sink))
        got = sink.getvalue()

        if len(got) != len(expected):
            raise Failure(
                'compose', f'the composition is {len(got)} bytes, expected {len(expected)}'
            )
        if got != expected:
            raise Failure(
                'compose', 'the composition is not the ordered concatenation of its three sources'
            )
        if hashlib.sha1(got).hexdigest() != hashlib.sha1(expected).hexdigest():
            raise Failure(
                'compose', "the composition's sha1 differs from the expected concatenation"
            )

        note(f'three sources of {part_size} bytes each: local range, copied range, stored object')
    finally:
        teardown(api, bucket)
        try:
            os.remove(local)
            os.rmdir(scratch)
        except Exception:  # noqa: BLE001
            pass


def main() -> int:
    target = os.environ.get('CONFORMANCE_TARGET', 'simulator')
    refused = refusal('conformance')
    if refused:
        say(target, f'FAIL ({refused})')
        return 1
    try:
        run(target)
    except Amber as amber:
        say(target, f'COULD-NOT-RUN ({amber.reason} -- {amber.detail})')
        return 0
    except Failure as failure:
        say(target, f'FAIL ({failure.step} -- {failure.detail})')
        return 1
    except Exception as error:  # noqa: BLE001 -- never a silent crash
        say(target, f'FAIL (setup -- {type(error).__name__})')
        return 1
    say(target, 'PASS')
    return 0


if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/env python3
"""b2-sdk-python x large.unbound_incremental.

Scenario (approved 2026-09-22, one per capability, identical on every tool that
claims it):

    Setup   a stream of undeclared length
    Action  upload it without a size
    Assert  the correct length and sha1 land

    b2-sdk-python's capabilities.tsv answers `yes`, not `partial`: it offers
    BOTH halves of this capability, so both are exercised. The unbound half
    uploads a read-only stream whose length is genuinely unknown to the caller;
    the incremental half appends to an already-stored file and is proved by the
    b2_copy_part call that reuses the stored prefix -- without that, an
    incremental upload is indistinguishable from a full re-upload.

NO DOCUMENTED CONTRACT FOUND for an upload of unknown length -- searched:
apidocs/b2-upload-file, apidocs/b2-upload-part, docs/cloud-storage-large-files,
docs/cloud-storage-create-large-files-with-the-native-api. At the wire B2
documents the opposite: "You must set the Content-Length HTTP header when
using either b2_upload_file or b2_upload_part. Chunked transfer encoding,
which allows the Content-Length header to be omitted, is not supported."
https://www.backblaze.com/apidocs/b2-upload-part
So "unbound" is built by the tool; the expected length and sha1 are those
of the bytes this check streamed.
The incremental half's b2_copy_part reuse of the stored prefix: "a large
file can be assembled from a mix of uploaded and copied parts." https://www.backblaze.com/docs/cloud-storage-large-files
NEEDS REVIEW: docs say a large file's contentSha1 is "none"; the assertion
also accepts None, and for a large file requires a matching large_file_sha1,
which b2_start_large_file recommends only "If the caller knows the SHA1
of the entire large file being uploaded" (https://www.backblaze.com/apidocs/b2-start-large-file)
-- an unbound stream's uploader cannot know it when the file is started.

Written from files.upload in this directory, the reference check. It exercises
b2sdk from this exact repository checkout; the API usage is taken from the
published b2sdk documentation.
"""

import collections
import hashlib
import io
import os
import sys
import tempfile
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
from loopback_guard import missing_runtime, refusal  # noqa: E402

SLUG = 'b2-sdk-python'
CAPABILITY = 'large.unbound_incremental'
UNBOUND_NAME = 'st/unbound.bin'
INCREMENTAL_NAME = 'st/incremental.bin'
UNBOUND_SIZE = 4096
APPENDED_SIZE = 1024

# The closed reason set. `lib/contract.py` only turns `no-realm-option`,
# `missing-runtime` and `not-claimed` into a SKIP. `unreachable` and
# `unauthorized` are never reported at the simulator: the runner supplies both
# the server and the credential, so those are FAIL, not amber.
REASONS = (
    'no-realm-option',
    'unreachable',
    'unauthorized',
    'no-credential',
    'missing-runtime',
    'not-claimed',
)

# A requested target maps to a realm or to amber. `simulator` is the harness's
# own loopback server, whose URL the dispatcher exports as
# CONFORMANCE_SIMULATOR_URL; unset, there is nothing to reach: no-realm-option.
REALMS = {
    'simulator': os.environ.get('CONFORMANCE_SIMULATOR_URL') or None,
}

# The simulator's fixed test credential, which the runner also injects. At
# @simulator the check uses it directly, so a real B2_* value can never be
# sent there.
SIM_CREDENTIAL = ('test-key-id', 'test-key')


def credential(realm):
    """The (key id, key) pair for a realm: the fixed one at @simulator."""
    if realm == REALMS['simulator']:
        return SIM_CREDENTIAL
    raise AssertionError('conformance checks use only the fixed simulator credential')


class Amber(Exception):
    """The question could not be asked. Reason must be in REASONS."""

    def __init__(self, reason: str, detail: str) -> None:
        assert reason in REASONS, reason
        self.reason = reason
        self.detail = detail


class Failure(Exception):
    """A golden-path step that did not do what the capability requires."""

    def __init__(self, step: str, detail: str) -> None:
        self.step = step
        self.detail = detail


def say(target: str, verdict: str) -> None:
    print(f'CONFORMANCE {SLUG} {CAPABILITY} @{target}: {verdict}')


def note(text: str) -> None:
    """Context for the log. NOT a result line.

    The runner reads only the CONFORMANCE line and a PASS carries no detail, so
    anything qualifying the STRENGTH of the evidence is said here, where it
    survives in the retained log without being mistaken for a verdict.
    """
    print(f'note {SLUG} {CAPABILITY}: {text}')


def step(name, action):
    """Run one golden-path step, converting the environment's own errors.

    A credential NEVER reaches the detail: only the exception class name.
    Every error here is a FAIL: the runner supplies both the simulator and the
    credential, so an auth error, access denied, connection error or SDK error
    is a defect, never an amber (COULD-NOT-RUN) result.
    """
    try:
        return action()
    except (Amber, Failure):
        raise
    except Exception as error:  # noqa: BLE001 -- classified below, never echoed
        name_of = type(error).__name__
        raise Failure(name, name_of) from error


def refused(name, action, expected):
    """Assert something is REFUSED, and record what refused it.

    `expected` is a tuple of exception class names. A different class -- or no
    exception at all -- is a Failure, because the refusal IS the claim here.
    """
    try:
        action()
    except (Amber, Failure):
        raise
    except Exception as error:  # noqa: BLE001 -- classified, never echoed
        name_of = type(error).__name__
        if name_of in expected:
            return name_of
        raise Failure(name, f"refused with {name_of}, expected {'/'.join(expected)}") from error
    raise Failure(name, 'the call was permitted; the claim under test is that it is refused')


def payload_of(size: int) -> bytes:
    """Deterministic filler of an exact size."""
    unit = b'sdkharness conformance '
    return (unit * (size // len(unit) + 1))[:size]


def prepare(target):
    """Realm, credentials and the INSTALLED package -- before any network call."""
    realm = REALMS.get(target)
    if realm is None:
        detail = (
            'CONFORMANCE_SIMULATOR_URL is unset'
            if target == 'simulator'
            else f"b2sdk exposes no '{target}' realm"
        )
        raise Amber('no-realm-option', detail)

    if not all(credential(realm)):
        raise Amber('no-credential', 'B2_APPLICATION_KEY_ID / B2_APPLICATION_KEY unset')

    try:
        import b2sdk.v3 as b2
    except ImportError as error:
        if not missing_runtime(error):
            # b2sdk is installed but broken: an SDK regression, not a missing runtime
            raise Failure('import', type(error).__name__) from error
        raise Amber('missing-runtime', 'b2sdk is not installed') from error

    return b2, realm


def authorize(api, realm):
    """Authorize against the named realm. Credentials never leave this call."""
    step(
        'authenticate',
        lambda: api.authorize_account(*credential(realm), realm=realm),
    )
    return api


def connect(target, **api_kwargs):
    """The common case: one authorized B2Api against the requested realm."""
    b2, realm = prepare(target)
    return b2, authorize(b2.B2Api(b2.InMemoryAccountInfo(), **api_kwargs), realm)


def new_bucket(api, **kwargs):
    """An ephemeral bucket, named as the contract requires."""
    name = f'sdkharness-conf-{uuid.uuid4().hex[:12]}'
    return step('create bucket', lambda: api.create_bucket(name, 'allPrivate', **kwargs))


def _delete_hard(api, bucket, version):
    """Delete one version, lifting a legal hold or a governance lock if it blocks."""
    for attempt in (0, 1):
        try:
            bucket.delete_file_version(
                version.id_, version.file_name, bypass_governance=attempt > 0
            )
            return
        except Exception:  # noqa: BLE001 -- cleanup must never mask the verdict
            if attempt == 0:
                try:
                    import b2sdk.v3 as b2

                    api.update_file_legal_hold(version.id_, version.file_name, b2.LegalHold.OFF)
                except Exception:  # noqa: BLE001
                    pass


def teardown(api, *buckets):
    """Owns what it created and destroys it, on the error path too."""
    for bucket in buckets:
        if bucket is None:
            continue
        try:
            for unfinished in bucket.list_unfinished_large_files():
                try:
                    bucket.cancel_large_file(unfinished.file_id)
                except Exception:  # noqa: BLE001
                    pass
        except Exception:  # noqa: BLE001
            pass
        try:
            versions = [v for v, _folder in bucket.ls('', recursive=True, latest_only=False)]
        except Exception:  # noqa: BLE001
            versions = []
        for version in versions:
            _delete_hard(api, bucket, version)
        try:
            api.delete_bucket(bucket)
        except Exception:  # noqa: BLE001
            pass


def drop_keys(api, key_ids):
    """Application keys are resources too."""
    for key_id in key_ids:
        if not key_id:
            continue
        try:
            api.delete_key_by_id(key_id)
        except Exception:  # noqa: BLE001
            pass


def counting_raw_api(b2, tally):
    """A raw API that counts the native calls this scenario is about.

    `B2HttpApiConfig(_raw_api_class=...)` is the SDK's own injection point, so
    this observes the real transport instead of standing in for it.
    """

    class Counting(b2.B2RawHTTPApi):
        def start_large_file(self, *args, **kwargs):
            tally['start_large_file'] += 1
            return super().start_large_file(*args, **kwargs)

        def upload_part(self, *args, **kwargs):
            tally['upload_part'] += 1
            return super().upload_part(*args, **kwargs)

        def copy_part(self, *args, **kwargs):
            tally['copy_part'] += 1
            return super().copy_part(*args, **kwargs)

        def upload_file(self, *args, **kwargs):
            tally['upload_file'] += 1
            return super().upload_file(*args, **kwargs)

        def authorize_account(self, *args, **kwargs):
            tally['authorize_account'] += 1
            return super().authorize_account(*args, **kwargs)

    return Counting


class UndeclaredLengthStream:
    """read() and nothing else -- the caller cannot know the length."""

    def __init__(self, data: bytes) -> None:
        self._inner = io.BytesIO(data)

    def read(self, size=-1):
        return self._inner.read(size)


def sha1_and_size(obj):
    if isinstance(obj, dict):
        return obj.get('contentSha1'), obj.get('contentLength'), dict(obj.get('fileInfo') or {})
    size = getattr(obj, 'size', None)
    if size is None:
        size = getattr(obj, 'content_length', None)
    return (
        getattr(obj, 'content_sha1', None),
        size,
        dict(getattr(obj, 'file_info', None) or {}),
    )


def run(target: str) -> None:
    b2, realm = prepare(target)
    tally = collections.Counter()
    api = b2.B2Api(
        b2.InMemoryAccountInfo(),
        api_config=b2.B2HttpApiConfig(_raw_api_class=counting_raw_api(b2, tally)),
        max_upload_workers=1,
    )
    authorize(api, realm)

    part_size = api.account_info.get_absolute_minimum_part_size()
    unbound_payload = payload_of(UNBOUND_SIZE)
    unbound_sha1 = hashlib.sha1(unbound_payload).hexdigest()

    scratch = tempfile.mkdtemp(prefix='sdkharness-conf-')
    local = os.path.join(scratch, 'incremental.bin')
    base = payload_of(part_size)
    with open(local, 'wb') as handle:
        handle.write(base)

    bucket = new_bucket(api)
    try:
        # --- unbound: a stream whose length is not declared --------------------
        uploaded = step(
            'upload an unbound stream',
            lambda: bucket.upload_unbound_stream(
                UndeclaredLengthStream(unbound_payload),
                UNBOUND_NAME,
                recommended_upload_part_size=part_size,
                buffer_size=part_size,
            ),
        )
        sha1, size, info = sha1_and_size(step('metadata', lambda: api.get_file_info(uploaded.id_)))
        if size != UNBOUND_SIZE:
            raise Failure('unbound', f'contentLength {size}, expected {UNBOUND_SIZE}')
        lowered = {str(k).lower(): v for k, v in info.items()}
        landed_sha1 = sha1 if sha1 not in (None, 'none') else lowered.get('large_file_sha1')
        if landed_sha1 != unbound_sha1:
            raise Failure('unbound', 'the sha1 that landed does not match the streamed bytes')

        sink = io.BytesIO()
        step(
            'download the unbound upload',
            lambda: bucket.download_file_by_name(UNBOUND_NAME).save(sink),
        )
        if sink.getvalue() != unbound_payload:
            raise Failure('unbound', 'the streamed bytes did not round-trip')

        # --- incremental: append to what is already stored ---------------------
        step(
            'upload the incremental base',
            lambda: bucket.upload_local_file(local, INCREMENTAL_NAME, min_part_size=part_size),
        )
        appended = payload_of(APPENDED_SIZE)[::-1]
        with open(local, 'ab') as handle:
            handle.write(appended)
        expected = base + appended

        before = tally['copy_part']
        step(
            'upload incrementally',
            lambda: bucket.upload_local_file(
                local,
                INCREMENTAL_NAME,
                min_part_size=part_size,
                upload_mode=b2.UploadMode.INCREMENTAL,
            ),
        )
        if tally['copy_part'] <= before:
            raise Failure(
                'incremental',
                'no b2_copy_part call: the stored prefix was re-uploaded, not appended to',
            )

        sink = io.BytesIO()
        step(
            'download the appended file',
            lambda: bucket.download_file_by_name(INCREMENTAL_NAME).save(sink),
        )
        got = sink.getvalue()
        if len(got) != len(expected):
            raise Failure(
                'incremental', f'the appended file is {len(got)} bytes, expected {len(expected)}'
            )
        if got != expected:
            raise Failure(
                'incremental', 'the appended file is not the base plus the appended bytes'
            )

        note(
            f"unbound stream of {UNBOUND_SIZE} undeclared bytes landed; incremental append reused "
            f"the stored prefix via {tally['copy_part'] - before} b2_copy_part call(s)"
        )
    finally:
        teardown(api, bucket)
        try:
            os.remove(local)
            os.rmdir(scratch)
        except Exception:  # noqa: BLE001
            pass


def main() -> int:
    target = os.environ.get('CONFORMANCE_TARGET', 'simulator')
    refused = refusal('conformance')
    if refused:
        say(target, f'FAIL ({refused})')
        return 1
    try:
        run(target)
    except Amber as amber:
        say(target, f'COULD-NOT-RUN ({amber.reason} -- {amber.detail})')
        return 0
    except Failure as failure:
        say(target, f'FAIL ({failure.step} -- {failure.detail})')
        return 1
    except Exception as error:  # noqa: BLE001 -- never a silent crash
        say(target, f'FAIL (setup -- {type(error).__name__})')
        return 1
    say(target, 'PASS')
    return 0


if __name__ == '__main__':
    sys.exit(main())

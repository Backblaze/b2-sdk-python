#!/usr/bin/env python3
"""b2-sdk-python x large.concurrent_parts.

Scenario (approved 2026-09-22, one per capability, identical on every tool that
claims it):

    Setup   a large payload, uploaded with concurrency 1 and then 4
    Action  upload it twice
    Assert  with 4 workers, more than 1 part upload is in flight at once

    KNOWN WEAK by design: without an instrumented transport this degrades to a
    wall-clock ratio, which is not proof. This check therefore instruments the
    SDK's own raw-API injection point and counts SIMULTANEOUS b2_upload_part
    calls -- still an in-process observation, not a packet capture, and the
    note() line says so. The wall-clock ratio is reported beside it as the
    weaker corroboration it is, never as the verdict.

DOCS -- B2 PERMITS concurrent part uploads and says how:
"Parts of a large file can be uploaded and copied in parallel, which can
significantly reduce the time it takes to upload terabytes of data."
https://www.backblaze.com/docs/cloud-storage-large-files
"Use b2_get_upload_part_url to get the target for uploading parts. Each
thread that uploads should get its own URL."
https://www.backblaze.com/docs/cloud-storage-create-large-files-with-the-native-api
PERMISSION ONLY: no B2 document requires a client to upload parts
concurrently, so the ">1 in flight at 4" expected value traces to the
tool's own concurrency setting, not to B2.

Written from bin/conformance/b2-sdk-python/files.upload, the reference check,
and bin/conformance/README.md, the contract. It exercises b2sdk from this exact repository
checkout; the API was taken from
docs/sdks/b2-sdk-python/card.md and the published b2sdk docs; the assertion now lives with the SDK code it exercises.
"""

import os
import sys
import threading
import time
import uuid

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'lib'))
from loopback_guard import refusal  # noqa: E402

SLUG = 'b2-sdk-python'
CAPABILITY = 'large.concurrent_parts'
OBJECT_SERIAL = 'st/concurrent-serial.bin'
OBJECT_PARALLEL = 'st/concurrent-parallel.bin'
PARTS_WANTED = 4
WORKERS = 4
OBSERVATION_DWELL_SECONDS = 0.1

# The closed reason set, mirrored from bin/conformance/README.md. The runner
# enforces it; naming one outside this tuple is a FAIL it manufactures.
REASONS = (
    'no-realm-option',
    'unreachable',
    'unauthorized',
    'no-credential',
    'missing-runtime',
    'not-claimed',
)

# A requested target maps to a realm or to amber. `simulator` is the harness's
# own server (bin/simulator/serve.mjs), whose URL the runner exports as
# CONFORMANCE_SIMULATOR_URL; unset, there is nothing to reach: no-realm-option.
REALMS = {
    'simulator': os.environ.get('CONFORMANCE_SIMULATOR_URL') or None,
}

# The simulator's fixed test credential, which the runner also injects. At
# @simulator the check uses it directly, so a real B2_* value can never be
# sent there.
SIM_CREDENTIAL = ('test-key-id', 'test-key')


def credential(realm):
    """The (key id, key) pair for a realm: the fixed one at @simulator."""
    if realm == REALMS['simulator']:
        return SIM_CREDENTIAL
    raise AssertionError('conformance checks use only the fixed simulator credential')


class Amber(Exception):
    """The question could not be asked. Reason must be in REASONS."""

    def __init__(self, reason: str, detail: str) -> None:
        assert reason in REASONS, reason
        self.reason = reason
        self.detail = detail


class Failure(Exception):
    """A golden-path step that did not do what the card claims."""

    def __init__(self, step: str, detail: str) -> None:
        self.step = step
        self.detail = detail


def say(target: str, verdict: str) -> None:
    print(f'CONFORMANCE {SLUG} {CAPABILITY} @{target}: {verdict}')


def note(text: str) -> None:
    """Context for the log. NOT a result line.

    The runner reads only the CONFORMANCE line and a PASS carries no detail, so
    anything qualifying the STRENGTH of the evidence is said here, where it
    survives in the retained log without being mistaken for a verdict.
    """
    print(f'note {SLUG} {CAPABILITY}: {text}')


def step(name, action):
    """Run one golden-path step, converting the environment's own errors.

    A credential NEVER reaches the detail: only the exception class name and,
    for a classified network/auth error, the class that classified it.
    """
    try:
        return action()
    except (Amber, Failure):
        raise
    except Exception as error:  # noqa: BLE001 -- classified below, never echoed
        name_of = type(error).__name__
        if name_of in ('Unauthorized', 'InvalidAuthToken', 'AccessDenied'):
            raise Amber('unauthorized', f"{name_of} at step '{name}'") from error
        if name_of in ('gaierror', 'ConnectionError', 'ServiceError', 'B2ConnectionError'):
            raise Amber('unreachable', f"{name_of} at step '{name}'") from error
        raise Failure(name, name_of) from error


def refused(name, action, expected):
    """Assert something is REFUSED, and record what refused it.

    `expected` is a tuple of exception class names. A different class -- or no
    exception at all -- is a Failure, because the refusal IS the claim here.
    """
    try:
        action()
    except (Amber, Failure):
        raise
    except Exception as error:  # noqa: BLE001 -- classified, never echoed
        name_of = type(error).__name__
        if name_of in expected:
            return name_of
        raise Failure(name, f"refused with {name_of}, expected {'/'.join(expected)}") from error
    raise Failure(name, 'the call was permitted; the claim under test is that it is refused')


def payload_of(size: int) -> bytes:
    """Deterministic filler of an exact size."""
    unit = b'sdkharness conformance '
    return (unit * (size // len(unit) + 1))[:size]


def prepare(target):
    """Realm, credentials and the INSTALLED package -- before any network call."""
    realm = REALMS.get(target)
    if realm is None:
        detail = (
            'CONFORMANCE_SIMULATOR_URL is unset'
            if target == 'simulator'
            else f"b2sdk exposes no '{target}' realm"
        )
        raise Amber('no-realm-option', detail)

    if not all(credential(realm)):
        raise Amber('no-credential', 'B2_APPLICATION_KEY_ID / B2_APPLICATION_KEY unset')

    try:
        import b2sdk.v3 as b2
    except ImportError as error:
        raise Amber('missing-runtime', 'b2sdk is not installed') from error

    return b2, realm


def authorize(api, realm):
    """Authorize against the named realm. Credentials never leave this call."""
    step(
        'authenticate',
        lambda: api.authorize_account(*credential(realm), realm=realm),
    )
    return api


def connect(target, **api_kwargs):
    """The common case: one authorized B2Api against the requested realm."""
    b2, realm = prepare(target)
    return b2, authorize(b2.B2Api(b2.InMemoryAccountInfo(), **api_kwargs), realm)


def new_bucket(api, **kwargs):
    """An ephemeral bucket, named as the contract requires."""
    name = f'sdkharness-conf-{uuid.uuid4().hex[:12]}'
    return step('create bucket', lambda: api.create_bucket(name, 'allPrivate', **kwargs))


def _delete_hard(api, bucket, version):
    """Delete one version, lifting a legal hold or a governance lock if it blocks."""
    for attempt in (0, 1):
        try:
            bucket.delete_file_version(
                version.id_, version.file_name, bypass_governance=attempt > 0
            )
            return
        except Exception:  # noqa: BLE001 -- cleanup must never mask the verdict
            if attempt == 0:
                try:
                    import b2sdk.v3 as b2

                    api.update_file_legal_hold(version.id_, version.file_name, b2.LegalHold.OFF)
                except Exception:  # noqa: BLE001
                    pass


def teardown(api, *buckets):
    """Owns what it created and destroys it, on the error path too."""
    for bucket in buckets:
        if bucket is None:
            continue
        try:
            for unfinished in bucket.list_unfinished_large_files():
                try:
                    bucket.cancel_large_file(unfinished.file_id)
                except Exception:  # noqa: BLE001
                    pass
        except Exception:  # noqa: BLE001
            pass
        try:
            versions = [v for v, _folder in bucket.ls('', recursive=True, latest_only=False)]
        except Exception:  # noqa: BLE001
            versions = []
        for version in versions:
            _delete_hard(api, bucket, version)
        try:
            api.delete_bucket(bucket)
        except Exception:  # noqa: BLE001
            pass


def drop_keys(api, key_ids):
    """Application keys are resources too."""
    for key_id in key_ids:
        if not key_id:
            continue
        try:
            api.delete_key_by_id(key_id)
        except Exception:  # noqa: BLE001
            pass


class Flight:
    """Counts b2_upload_part calls that overlap in time."""

    def __init__(self):
        self.lock = threading.Lock()
        self.in_flight = 0
        self.peak = 0
        self.parts = 0

    def enter(self):
        with self.lock:
            self.in_flight += 1
            self.parts += 1
            self.peak = max(self.peak, self.in_flight)

    def leave(self):
        with self.lock:
            self.in_flight -= 1


def flight_raw_api(b2, flight):
    class Watched(b2.B2RawHTTPApi):
        def upload_part(self, *args, **kwargs):
            flight.enter()
            try:
                # Hold each part open briefly so simultaneous uploads are
                # OBSERVABLE. Without it a fast call can finish before the next
                # one starts and true concurrency reads as serial -- the
                # observation window, not the concurrency, would be what failed.
                time.sleep(OBSERVATION_DWELL_SECONDS)
                return super().upload_part(*args, **kwargs)
            finally:
                flight.leave()

    return Watched


def upload_once(b2, realm, bucket_name, object_name, workers, payload, part_size):
    flight = Flight()
    api = b2.B2Api(
        b2.InMemoryAccountInfo(),
        api_config=b2.B2HttpApiConfig(_raw_api_class=flight_raw_api(b2, flight)),
        max_upload_workers=workers,
    )
    authorize(api, realm)
    bucket = step('open bucket', lambda: api.get_bucket_by_name(bucket_name))
    started = time.monotonic()
    step(
        f'upload with {workers} worker(s)',
        lambda: bucket.create_file(
            [b2.WriteIntent(b2.UploadSourceBytes(payload))],
            object_name,
            recommended_upload_part_size=part_size,
            min_part_size=part_size,
            max_part_size=part_size,
        ),
    )
    return flight, time.monotonic() - started


def run(target: str) -> None:
    b2, realm = prepare(target)
    api = authorize(b2.B2Api(b2.InMemoryAccountInfo()), realm)

    part_size = api.account_info.get_absolute_minimum_part_size()
    payload = payload_of(part_size * PARTS_WANTED)

    bucket = new_bucket(api)
    try:
        serial, serial_seconds = upload_once(
            b2, realm, bucket.name, OBJECT_SERIAL, 1, payload, part_size
        )
        parallel, parallel_seconds = upload_once(
            b2, realm, bucket.name, OBJECT_PARALLEL, WORKERS, payload, part_size
        )

        if serial.parts < 2 or parallel.parts < 2:
            raise Failure(
                'setup',
                f'only {min(serial.parts, parallel.parts)} part(s) uploaded; there is no concurrency to observe',
            )
        if serial.peak != 1:
            raise Failure(
                'concurrency',
                f'with max_upload_workers=1 the peak in-flight part count was {serial.peak}, expected 1',
            )
        if parallel.peak < 2:
            raise Failure(
                'concurrency',
                f'with max_upload_workers={WORKERS} the peak in-flight part count was still {parallel.peak}',
            )

        ratio = (serial_seconds / parallel_seconds) if parallel_seconds > 0 else 0.0
        note(
            f'evidence: peak simultaneous b2_upload_part calls {serial.peak} -> {parallel.peak}, '
            f'observed in-process at the raw-API boundary (each part held {OBSERVATION_DWELL_SECONDS}s '
            f'to widen the observation window), NOT at the transport. '
            f'wall-clock ratio {ratio:.2f}x is corroboration only and proves nothing on its own.'
        )
    finally:
        teardown(api, bucket)


def main() -> int:
    target = os.environ.get('CONFORMANCE_TARGET', 'simulator')
    refused = refusal('conformance')
    if refused:
        say(target, f'FAIL ({refused})')
        return 1
    try:
        run(target)
    except Amber as amber:
        say(target, f'COULD-NOT-RUN ({amber.reason} -- {amber.detail})')
        return 0
    except Failure as failure:
        say(target, f'FAIL ({failure.step} -- {failure.detail})')
        return 1
    except Exception as error:  # noqa: BLE001 -- never a silent crash
        say(target, f'FAIL (setup -- {type(error).__name__})')
        return 1
    say(target, 'PASS')
    return 0


if __name__ == '__main__':
    sys.exit(main())
